# ClaimLens AI — Environment Variables
# Copy this file to .env and fill in your values

# Anthropic API Key (required for AI analysis)
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_api_key_here

# Sightengine credentials (optional — enables AI-generated image detection on claim uploads)
# Sign up at: https://sightengine.com/ (free tier = ~2k requests/month)
SIGHTENGINE_USER=your_sightengine_user_here
SIGHTENGINE_SECRET=your_sightengine_secret_here

# Server port (optional, defaults to 3000)
PORT=3000

# User accounts are managed in data/users.json
# Default accounts: admin/claimlens2026, demo1/demo2026, demo2/demo2026
